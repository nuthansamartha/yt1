PORT=5000
NODE_ENV=development
MAX_DOWNLOAD_SIZE_GB=10
JOB_EXPIRATION_MINUTES=30
DOWNLOAD_DIR=./downloads
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
DOWNLOAD_RATE_LIMIT_MAX=10
STATUS_RATE_LIMIT_MAX=3000

# Path to a Netscape-format cookies.txt file exported from YouTube.
# In production (Render), add this as a Secret File at /etc/secrets/www.youtube.com_cookies.txt
# and set: YOUTUBE_COOKIES_PATH=/etc/secrets/www.youtube.com_cookies.txt
# In local development, place the file in backend/ and set:
# YOUTUBE_COOKIES_PATH=./www.youtube.com_cookies.txt
# IMPORTANT: Never commit this file to git. It is listed in .gitignore.
# YOUTUBE_COOKIES_PATH=/etc/secrets/www.youtube.com_cookies.txt

